<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FerreteriaERP.UI.Desktop.ViewModels"
             xmlns:entities="using:FerreteriaERP.Core.Entities"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             Background="{StaticResource PrimaryBackgroundBrush}"
             x:Class="FerreteriaERP.UI.Desktop.Views.ReabastecimientoView"
             x:DataType="vm:ReabastecimientoViewModel">

    <Grid RowDefinitions="Auto,Auto,5.4*,16,4.6*" Margin="20,16">

        <!-- =============================================================== -->
        <!-- 1. ENCABEZADO DEL MÓDULO                                        -->
        <!-- =============================================================== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Classes="h1"
                           Text="Reabastecimiento y Órdenes de Compra" />
                <TextBlock Classes="subtitle"
                           Text="Generación automática de pedidos para productos con stock crítico y recepción directa al inventario."
                           TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1"
                    Classes="ghost"
                    Command="{Binding InicializarCommand}"
                    IsEnabled="{Binding ControlesHabilitados}"
                    VerticalAlignment="Center"
                    Padding="14,9">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Refresh"
                                                Width="17"
                                                Height="17"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="Actualizar"
                               Foreground="{Binding $parent[Button].Foreground}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- =============================================================== -->
        <!-- 2. ALERTAS DE ESTADO                                            -->
        <!-- =============================================================== -->
        <Panel Grid.Row="1">
            <Border Padding="14,9"
                    Margin="0,0,0,10"
                    CornerRadius="10"
                    Background="{StaticResource DangerSubtleBgBrush}"
                    BorderBrush="{StaticResource DangerSubtleBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding MostrarError}">
                <TextBlock Text="{Binding MensajeEstado}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <Border Padding="14,9"
                    Margin="0,0,0,10"
                    CornerRadius="10"
                    Background="{StaticResource SuccessSubtleBgBrush}"
                    BorderBrush="{StaticResource SuccessSubtleBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding MostrarExito}">
                <TextBlock Text="{Binding MensajeEstado}"
                           Foreground="{StaticResource PrimaryAccentHoverBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>
        </Panel>

        <!-- =============================================================== -->
        <!-- 3. SECCIÓN SUPERIOR: STOCK CRÍTICO (*) + EMISIÓN DE PEDIDO (310)-->
        <!-- =============================================================== -->
        <Grid Grid.Row="2" ColumnDefinitions="*, 310">

            <!-- Tabla de Productos con Stock Crítico / Bajo -->
            <Border Grid.Column="0"
                    Classes="Card"
                    Margin="0,0,16,0"
                    Padding="14,12"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,10,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline"
                                                    Width="18"
                                                    Height="18"
                                                    Foreground="#D97706"
                                                    VerticalAlignment="Center" />
                        <TextBlock Classes="h2"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Text="Productos con Stock Crítico / Bajo"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding ProductosStockCritico}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  HorizontalScrollBarVisibility="Auto"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <!-- CheckBox Selección -->
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ProductoReabastecimientoItem">
                                            <CheckBox IsChecked="{Binding Seleccionado, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Producto + Estado Agotado/Bajo -->
                                <DataGridTemplateColumn Header="PRODUCTO" Width="*" MinWidth="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ProductoReabastecimientoItem">
                                            <StackPanel Margin="8,5" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Nombre}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Padding="7,1"
                                                            CornerRadius="999"
                                                            Background="{StaticResource DangerSubtleBgBrush}"
                                                            BorderBrush="{StaticResource DangerSubtleBorderBrush}"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding EsAgotado}">
                                                        <TextBlock Text="Agotado"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource DangerBrush}" />
                                                    </Border>
                                                    <Border Padding="7,1"
                                                            CornerRadius="999"
                                                            Background="#FEF3C7"
                                                            BorderBrush="#FDE68A"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding EsBajo}">
                                                        <TextBlock Text="Bajo"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#B45309" />
                                                    </Border>
                                                    <TextBlock Text="{Binding CodigoBarras}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Stock Actual (centrado) -->
                                <DataGridTemplateColumn Header="ACTUAL" Width="Auto" MinWidth="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ProductoReabastecimientoItem">
                                            <TextBlock Text="{Binding StockActual}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Stock Mínimo (centrado) -->
                                <DataGridTemplateColumn Header="MÍNIMO" Width="Auto" MinWidth="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ProductoReabastecimientoItem">
                                            <TextBlock Text="{Binding StockMinimo}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cantidad a Pedir (Editable) -->
                                <DataGridTemplateColumn Header="CANT. A PEDIR" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ProductoReabastecimientoItem">
                                            <TextBox Text="{Binding CantidadAPedir, Mode=TwoWay}"
                                                     PlaceholderText="5"
                                                     Width="90"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Center"
                                                     Padding="6,4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Costo Unitario Estimado -->
                                <DataGridTemplateColumn Header="COSTO UNIT." Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ProductoReabastecimientoItem">
                                            <TextBox Text="{Binding CostoUnitarioEstimado, Mode=TwoWay}"
                                                     PlaceholderText="0.00"
                                                     Width="95"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     HorizontalContentAlignment="Right"
                                                     Padding="6,4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Subtotal -->
                                <DataGridTextColumn Header="SUBTOTAL"
                                                    Width="115"
                                                    IsReadOnly="True"
                                                    Binding="{Binding SubtotalEstimadoTexto}"
                                                    x:DataType="vm:ProductoReabastecimientoItem" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="20,16"
                                CornerRadius="10"
                                Background="{StaticResource SuccessSubtleBgBrush}"
                                BorderBrush="{StaticResource SuccessSubtleBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding SinProductosCriticos}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CheckCircleOutline"
                                                            Width="28"
                                                            Height="28"
                                                            Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                            HorizontalAlignment="Center" />
                                <TextBlock Text="Todo el inventario está en niveles óptimos"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Panel Derecho (310px): Proveedor, Observaciones y Botón Generar PDF -->
            <Border Grid.Column="1"
                    Classes="Card"
                    Padding="16,14"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Classes="label"
                                   Text="EMISIÓN DE PEDIDO"
                                   Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                        <TextBlock Text="{Binding TotalEstimadoTexto}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryAccentBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ResumenSeleccionTexto}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,10,0,10">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="PROVEEDOR DESTINATARIO *" />
                                <ComboBox ItemsSource="{Binding ProveedoresDisponibles}"
                                          SelectedItem="{Binding ProveedorSeleccionado}"
                                          IsEnabled="{Binding ControlesHabilitados}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="entities:Proveedor">
                                            <TextBlock Text="{Binding NombreComercialMostrar}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Classes="label" Text="OBSERVACIONES / CONDICIONES" />
                                <TextBox Text="{Binding ObservacionesOrden}"
                                         PlaceholderText="Ej. Entrega urgente en sucursal central..."
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="62"
                                         IsEnabled="{Binding ControlesHabilitados}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Command="{Binding GenerarOrdenCompraCommand}"
                            IsEnabled="{Binding ControlesHabilitados}"
                            Height="44"
                            Padding="10,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="FilePdfBox"
                                                        Width="17"
                                                        Height="17"
                                                        Foreground="#FFFFFF"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TextoBotonGenerar}"
                                       Foreground="#FFFFFF"
                                       FontWeight="Bold"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- =============================================================== -->
        <!-- 4. SECCIÓN INFERIOR: HISTORIAL DE ÓRDENES DE COMPRA             -->
        <!-- =============================================================== -->
        <Border Grid.Row="4"
                Classes="Card"
                Padding="14,12"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,10,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="ClipboardListOutline"
                                                Width="18"
                                                Height="18"
                                                Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                VerticalAlignment="Center" />
                    <TextBlock Classes="h2"
                               FontSize="15"
                               FontWeight="Bold"
                               Text="Historial de Órdenes de Compra Emitidas"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding HistorialOrdenes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              HorizontalScrollBarVisibility="Auto"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NRO. ORDEN"
                                                Width="130"
                                                Binding="{Binding NumeroOrden}"
                                                x:DataType="entities:OrdenCompra" />

                            <DataGridTextColumn Header="FECHA EMISIÓN"
                                                Width="145"
                                                Binding="{Binding FechaEmisionTexto}"
                                                x:DataType="entities:OrdenCompra" />

                            <DataGridTextColumn Header="PROVEEDOR"
                                                Width="*"
                                                MinWidth="160"
                                                Binding="{Binding NombreProveedorTexto}"
                                                x:DataType="entities:OrdenCompra" />

                            <DataGridTextColumn Header="TOTAL ESTIMADO"
                                                Width="135"
                                                Binding="{Binding TotalEstimadoTexto}"
                                                x:DataType="entities:OrdenCompra" />

                            <DataGridTemplateColumn Header="ESTADO" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="entities:OrdenCompra">
                                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Padding="9,3"
                                                    CornerRadius="999"
                                                    Background="#FEF3C7"
                                                    BorderBrush="#FDE68A"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding EsPendiente}">
                                                <TextBlock Text="Pendiente"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#B45309" />
                                            </Border>

                                            <Border Padding="9,3"
                                                    CornerRadius="999"
                                                    Background="#ECFDF5"
                                                    BorderBrush="#A7F3D0"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding EsRecibida}">
                                                <TextBlock Text="Recibida"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#059669" />
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Acciones por Fila: Ver PDF y Recibir Mercadería -->
                            <DataGridTemplateColumn Header="ACCIONES" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="entities:OrdenCompra">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="4,4">
                                            <Button Classes="ghost"
                                                    Content="Ver PDF"
                                                    Padding="8,4"
                                                    FontSize="11.5"
                                                    Command="{Binding $parent[UserControl].((vm:ReabastecimientoViewModel)DataContext).VerPdfOrdenCommand}"
                                                    CommandParameter="{Binding}" />

                                            <Button Content="Recibir Mercadería"
                                                    Padding="8,4"
                                                    FontSize="11.5"
                                                    IsVisible="{Binding EsPendiente}"
                                                    Command="{Binding $parent[UserControl].((vm:ReabastecimientoViewModel)DataContext).RecibirMercaderiaCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="4"
                                IsVisible="{Binding SinHistorialOrdenes}"
                                IsHitTestVisible="False">
                        <TextBlock Text="Aún no se han emitido órdenes de compra"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
