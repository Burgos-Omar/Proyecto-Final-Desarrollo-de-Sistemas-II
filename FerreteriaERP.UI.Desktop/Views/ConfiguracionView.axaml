<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FerreteriaERP.UI.Desktop.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="760"
             Background="{StaticResource PrimaryBackgroundBrush}"
             x:Class="FerreteriaERP.UI.Desktop.Views.ConfiguracionView"
             x:DataType="vm:ConfiguracionViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="22"
                    MaxWidth="640"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Margin="28,28">

            <!-- ========================================================= -->
            <!-- TARJETA 0: DATOS FISCALES DEL NEGOCIO (NIT)               -->
            <!-- ========================================================= -->
            <Border Classes="Card"
                    Padding="0"
                    ClipToBounds="True"
                    IsVisible="{Binding MostrarConfiguracionCompleta}">
                <StackPanel>
                    <Border Height="4"
                            Background="{StaticResource PrimaryAccentBrush}" />

                    <StackPanel Spacing="14" Margin="28,22">
                        <Grid ColumnDefinitions="Auto,14,*">
                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="12"
                                    Background="{StaticResource AccentSubtleBgBrush}"
                                    BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <materialIcons:MaterialIcon Kind="StorefrontOutline"
                                                            Width="24"
                                                            Height="24"
                                                            Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Classes="label"
                                           Text="IDENTIDAD VISUAL Y FISCAL"
                                           Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                                <TextBlock Classes="h2"
                                           Text="Identidad, Logo y Datos Fiscales del Negocio" />
                                <TextBlock Classes="subtitle"
                                           Text="Personalice el nombre, NIT y logo de la ferretería. Se aplicarán en el menú lateral, Login, Caja (POS) y encabezados PDF."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,12,210">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Classes="label" Text="NOMBRE DE LA FERRETERÍA / RAZÓN SOCIAL" />
                                <TextBox Text="{Binding NombreNegocioForm}"
                                         PlaceholderText="Ej. Ferretería Central S.R.L."
                                         IsEnabled="{Binding CamposHabilitados}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Classes="label" Text="NIT DEL NEGOCIO" />
                                <TextBox Text="{Binding NitNegocioForm}"
                                         PlaceholderText="Ej. 1020304050"
                                         MaxLength="30"
                                         IsEnabled="{Binding CamposHabilitados}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,12,210">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Classes="label" Text="DIRECCIÓN DEL NEGOCIO" />
                                <TextBox Text="{Binding DireccionForm}"
                                         PlaceholderText="Ej. Av. Domingo Paz #123, Tarija"
                                         IsEnabled="{Binding CamposHabilitados}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="5">
                                <TextBlock Classes="label" Text="TELÉFONO / WHATSAPP" />
                                <TextBox Text="{Binding TelefonoForm}"
                                         PlaceholderText="Ej. +591 74500000"
                                         IsEnabled="{Binding CamposHabilitados}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="5">
                            <TextBlock Classes="label" Text="MENSAJE DE PIE DE RECIBO" />
                            <TextBox Text="{Binding MensajePieReciboForm}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="65"
                                     PlaceholderText="Ej. Gracias por su compra. Cambios solo con recibo dentro de 48 hrs."
                                     IsEnabled="{Binding CamposHabilitados}" />
                        </StackPanel>

                        <Button Content="Guardar Datos Fiscales, Contacto y Pie de Recibo"
                                Command="{Binding GuardarDatosFiscalesCommand}"
                                IsEnabled="{Binding CamposHabilitados}"
                                Height="42"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" />

                        <Border Height="1"
                                Background="{StaticResource SubtleBorderBrush}"
                                Margin="0,4" />

                        <!-- Sección Logo del Negocio (PASO 31c) -->
                        <StackPanel Spacing="10">
                            <TextBlock Classes="label" Text="LOGO DEL NEGOCIO (ENCABEZADOS PDF)" />

                            <Grid ColumnDefinitions="Auto,18,*">
                                <!-- Vista Previa del Logo (140x140) -->
                                <Border Grid.Column="0"
                                        Width="140"
                                        Height="140"
                                        CornerRadius="12"
                                        Background="#FFFFFF"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1.5"
                                        Padding="8">
                                    <Panel>
                                        <Image Source="{Binding LogoPreviewBitmap}"
                                               Stretch="Uniform"
                                               IsVisible="{Binding TieneLogoConfigurado}" />

                                        <StackPanel Spacing="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding SinLogoConfigurado}">
                                            <materialIcons:MaterialIcon Kind="ImageOutline"
                                                                        Width="32"
                                                                        Height="32"
                                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                                        HorizontalAlignment="Center" />
                                            <TextBlock Text="Sin logo"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </Border>

                                <!-- Controles de Logo -->
                                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Classes="subtitle"
                                               Text="Formatos admitidos: PNG, JPG, JPEG o WEBP. Se mostrará automáticamente en Recibos, Proformas y Órdenes de Compra."
                                               TextWrapping="Wrap" />

                                    <Button Classes="ghost"
                                            Command="{Binding SeleccionarLogoCommand}"
                                            IsEnabled="{Binding CamposHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="ImagePlusOutline"
                                                                        Width="17"
                                                                        Height="17"
                                                                        VerticalAlignment="Center" />
                                            <TextBlock Text="Seleccionar Logo"
                                                       Foreground="{Binding $parent[Button].Foreground}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <Button Grid.Column="0"
                                                Content="Guardar Logo"
                                                Command="{Binding GuardarLogoCommand}"
                                                IsEnabled="{Binding TieneLogoConfigurado}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" />

                                        <Button Grid.Column="2"
                                                Classes="danger-ghost"
                                                Content="Eliminar Logo"
                                                Command="{Binding EliminarLogoCommand}"
                                                IsEnabled="{Binding TieneLogoConfigurado}"
                                                Padding="12,8" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- TARJETA 1: COBRO POR QR BANCARIO (PASO 31)                -->
            <!-- ========================================================= -->
            <Border Classes="Card"
                    Padding="0"
                    ClipToBounds="True"
                    IsVisible="{Binding MostrarConfiguracionCompleta}">
                <StackPanel>
                    <Border Height="4"
                            Background="#0284C7" />

                    <StackPanel Spacing="16" Margin="28,22">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="label"
                                       Text="COBRO POR QR BANCARIO"
                                       Foreground="#0284C7" />
                            <TextBlock Classes="h2"
                                       Text="Código QR Simple del Negocio" />
                            <TextBlock Classes="subtitle"
                                       Text="Cargue la imagen de su QR bancario para mostrarla automáticamente a los clientes en Caja (POS)."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,20,*">
                            <!-- Vista Previa del QR (200x200) -->
                            <Border Grid.Column="0"
                                    Width="200"
                                    Height="200"
                                    CornerRadius="12"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1.5"
                                    Padding="10">
                                <Panel>
                                    <Image Source="{Binding QrPreviewBitmap}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding TieneQrConfigurado}" />

                                    <StackPanel Spacing="8"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding SinQrConfigurado}">
                                        <materialIcons:MaterialIcon Kind="QrcodeScan"
                                                                    Width="40"
                                                                    Height="40"
                                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                                    HorizontalAlignment="Center" />
                                        <TextBlock Text="Sin QR configurado"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Panel>
                            </Border>

                            <!-- Datos Bancarios y Botones de Acción -->
                            <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="BANCO / ENTIDAD FINANCIERA" />
                                    <TextBox Text="{Binding BancoQr}"
                                             PlaceholderText="Ej. BNB - QR Simple / Banco Unión"
                                             IsEnabled="{Binding CamposHabilitados}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="TITULAR DE LA CUENTA" />
                                    <TextBox Text="{Binding TitularQr}"
                                             PlaceholderText="Ej. Ferretería Central S.R.L."
                                             IsEnabled="{Binding CamposHabilitados}" />
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <Button Classes="ghost"
                                            Command="{Binding SeleccionarImagenQrCommand}"
                                            IsEnabled="{Binding CamposHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="ImagePlusOutline"
                                                                        Width="17"
                                                                        Height="17"
                                                                        VerticalAlignment="Center" />
                                            <TextBlock Text="Seleccionar Imagen QR"
                                                       Foreground="{Binding $parent[Button].Foreground}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <Button Grid.Column="0"
                                                Content="Guardar QR"
                                                Command="{Binding GuardarQrCommand}"
                                                IsEnabled="{Binding TieneQrConfigurado}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center" />

                                        <Button Grid.Column="2"
                                                Classes="danger-ghost"
                                                Content="Eliminar QR"
                                                Command="{Binding EliminarQrCommand}"
                                                IsEnabled="{Binding TieneQrConfigurado}"
                                                Padding="12,8" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- TARJETA 2: SEGURIDAD Y RESPALDOS (PASO 25)                -->
            <!-- ========================================================= -->
            <Border Classes="Card"
                    Padding="0"
                    ClipToBounds="True"
                    IsVisible="{Binding MostrarConfiguracionCompleta}">
                <StackPanel>
                    <Border Height="4"
                            Background="#4F46E5" />

                    <StackPanel Spacing="16" Margin="28,22">
                        <Grid ColumnDefinitions="Auto,14,*">
                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    CornerRadius="12"
                                    Background="#EEF2FF"
                                    BorderBrush="#C7D2FE"
                                    BorderThickness="1"
                                    VerticalAlignment="Top">
                                <materialIcons:MaterialIcon Kind="Database"
                                                            Width="24"
                                                            Height="24"
                                                            Foreground="#4F46E5"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Classes="label"
                                           Text="SEGURIDAD Y RESPALDOS"
                                           Foreground="#4F46E5" />
                                <TextBlock Classes="h2"
                                           Text="Respaldo de Base de Datos PostgreSQL" />
                                <TextBlock Classes="subtitle"
                                           Text="Genera una copia completa de la base de datos (inventario, ventas, usuarios)."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding GenerarRespaldoCommand}"
                                IsEnabled="{Binding CamposHabilitados}"
                                Background="#4F46E5"
                                Foreground="#FFFFFF"
                                Height="44"
                                CornerRadius="10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="DatabaseExportOutline"
                                                            Width="18"
                                                            Height="18"
                                                            Foreground="#FFFFFF"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TextoBotonRespaldo}"
                                           Foreground="#FFFFFF"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- TARJETA 2: CONFIGURACIÓN DE RED Y CONEXIÓN POSTGRESQL     -->
            <!-- ========================================================= -->
            <Border Classes="Card"
                    Padding="0"
                    ClipToBounds="True">

                <StackPanel>
                    <!-- Barra superior corporativa de acento -->
                    <Border Height="4"
                            Background="{StaticResource PrimaryAccentBrush}" />

                    <StackPanel Spacing="18" Margin="28,24,28,26">
                        <!-- Encabezado -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label"
                                       Text="CONEXIÓN DEL EQUIPO"
                                       Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                            <TextBlock Classes="h2"
                                       Text="Parámetros de Red y Servidor PostgreSQL" />
                            <TextBlock Classes="subtitle"
                                       Text="Defina el modo de operación (Central o Sucursal remota) para este equipo."
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Selector Central / Sucursal -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label"
                                       Text="MODO DE OPERACIÓN" />

                            <Border Padding="14,12"
                                    CornerRadius="8"
                                    Background="{StaticResource PrimaryBackgroundBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <RadioButton GroupName="ModoConexion"
                                                 Content="Soy la Central (Local)"
                                                 IsChecked="{Binding EsCentral}"
                                                 IsEnabled="{Binding CamposHabilitados}" />
                                    <RadioButton GroupName="ModoConexion"
                                                 Content="Soy una Sucursal (Remoto)"
                                                 IsChecked="{Binding EsSucursal}"
                                                 IsEnabled="{Binding CamposHabilitados}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Campo IP de VPN (solo visible en modo Sucursal) -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding EsSucursal}">
                            <TextBlock Classes="label"
                                       Text="IP DE LA VPN DEL SERVIDOR CENTRAL" />
                            <TextBox Text="{Binding IpVpn}"
                                     PlaceholderText="Ej. 100.64.0.1 (Tailscale / ZeroTier)"
                                     IsEnabled="{Binding CamposHabilitados}" />
                        </StackPanel>

                        <!-- Campo Contraseña de Base de Datos -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label"
                                       Text="CONTRASEÑA DE LA BASE DE DATOS (POSTGRESQL)" />
                            <TextBox Text="{Binding PasswordBd}"
                                     PasswordChar="*"
                                     PlaceholderText="Contraseña del usuario postgres"
                                     IsEnabled="{Binding CamposHabilitados}" />
                        </StackPanel>

                        <!-- Resumen técnico de conexión -->
                        <Border Padding="12,10"
                                CornerRadius="8"
                                Background="{StaticResource AccentSubtleBgBrush}"
                                BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ResumenConexion}"
                                       Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Mensaje de error -->
                        <Border Padding="12,10"
                                CornerRadius="8"
                                Background="{StaticResource DangerSubtleBgBrush}"
                                BorderBrush="{StaticResource DangerSubtleBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding MostrarError}">
                            <TextBlock Text="{Binding MensajeEstado}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Mensaje de éxito -->
                        <Border Padding="12,10"
                                CornerRadius="8"
                                Background="{StaticResource SuccessSubtleBgBrush}"
                                BorderBrush="{StaticResource SuccessSubtleBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding MostrarExito}">
                            <TextBlock Text="{Binding MensajeEstado}"
                                       Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Acciones -->
                        <StackPanel Spacing="10" Margin="0,4,0,0">
                            <Button Content="{Binding TextoBotonGuardar}"
                                    Command="{Binding GuardarYProbarConexionCommand}"
                                    IsDefault="True"
                                    Height="42"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />

                            <Button Classes="ghost"
                                    Content="Volver"
                                    Command="{Binding CancelarCommand}"
                                    IsVisible="{Binding PermitirCancelar}"
                                    IsEnabled="{Binding CamposHabilitados}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
