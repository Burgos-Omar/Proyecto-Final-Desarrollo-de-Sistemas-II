<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FerreteriaERP.UI.Desktop.ViewModels"
             xmlns:entities="using:FerreteriaERP.Core.Entities"
             xmlns:converters="using:FerreteriaERP.UI.Desktop.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             Background="{StaticResource PrimaryBackgroundBrush}"
             x:Class="FerreteriaERP.UI.Desktop.Views.PosView"
             x:DataType="vm:PosViewModel">

    <UserControl.Resources>
        <converters:StringToBitmapConverter x:Key="ImageConverter" />
    </UserControl.Resources>

    <Grid ColumnDefinitions="7*,20,3*" Margin="24,18">

        <!-- ========================================================= -->
        <!-- COLUMNA IZQUIERDA (70%): CATÁLOGO VISUAL + CARRITO        -->
        <!-- ========================================================= -->
        <Grid Grid.Column="0" RowDefinitions="5.6*,14,4.4*">

            <!-- ===================================================== -->
            <!-- FILA SUPERIOR (56%): BUSCADOR/ESCÁNER + CATÁLOGO      -->
            <!-- ===================================================== -->
            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,*">

                <!-- 1. Buscador / Escáner USB (Enter ejecuta ProcesarEscaneoCommand) -->
                <Border Grid.Row="0"
                        Classes="Card"
                        Padding="16,12"
                        Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,10,Auto">

                        <Border Grid.Column="0"
                                Background="#F8FAFC"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,2">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0"
                                                            Kind="BarcodeScan"
                                                            Width="22"
                                                            Height="22"
                                                            Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                            VerticalAlignment="Center"
                                                            Margin="2,0,10,0" />

                                <TextBox x:Name="TxtCodigoBarras"
                                         Grid.Column="1"
                                         Text="{Binding TextoBusqueda}"
                                         PlaceholderText="Escanee código de barras (Enter) o escriba para filtrar el catálogo visual..."
                                         FontSize="15"
                                         FontWeight="Medium"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="4,8"
                                         IsEnabled="{Binding ControlesHabilitados}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding ProcesarEscaneoCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <Button Grid.Column="2"
                                        Classes="link"
                                        Command="{Binding LimpiarBusquedaCommand}"
                                        IsVisible="{Binding TieneTextoBusqueda}"
                                        Padding="6"
                                        VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloseCircle"
                                                                Width="17"
                                                                Height="17"
                                                                Foreground="{StaticResource SecondaryTextBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2"
                                Classes="ghost"
                                ToolTip.Tip="Actualizar productos en stock"
                                Command="{Binding CargarCatalogoCommand}"
                                IsEnabled="{Binding ControlesHabilitados}"
                                Padding="14,10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Refresh"
                                                            Width="17"
                                                            Height="17"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="Catálogo"
                                           Foreground="{Binding $parent[Button].Foreground}"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 2. Alertas de Estado (Error de Stock / Venta Completada) -->
                <Panel Grid.Row="1">
                    <Border Padding="14,9"
                            Margin="0,0,0,10"
                            CornerRadius="10"
                            Background="{StaticResource DangerSubtleBgBrush}"
                            BorderBrush="{StaticResource DangerSubtleBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding MostrarError}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="AlertCircleOutline"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MensajeEstado}"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Padding="14,9"
                            Margin="0,0,0,10"
                            CornerRadius="10"
                            Background="{StaticResource SuccessSubtleBgBrush}"
                            BorderBrush="{StaticResource SuccessSubtleBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding MostrarExito}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="CheckCircleOutline"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{StaticResource SuccessBrush}"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MensajeEstado}"
                                       Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- 3. Catálogo Visual de Productos (ScrollViewer + ItemsControl + WrapPanel) -->
                <Panel Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,2,0,4">
                        <ItemsControl ItemsSource="{Binding CatalogoVisible}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:Producto">
                                    <!-- TARJETA POS DEL PRODUCTO -->
                                    <Border Classes="Card"
                                            Width="192"
                                            Margin="0,0,14,14"
                                            Padding="12">
                                        <StackPanel Spacing="9">

                                            <!-- Imagen del Producto con StringToBitmapConverter -->
                                            <Border Height="96"
                                                    CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Background="#F1F5F9">
                                                <Panel>
                                                    <Image Source="{StaticResource ProductPlaceholderDrawing}"
                                                           Stretch="UniformToFill" />

                                                    <Image Source="{Binding ImagenUrl, Converter={StaticResource ImageConverter}}"
                                                           Stretch="UniformToFill" />

                                                    <!-- Código de barras discreto arriba a la izquierda -->
                                                    <Border HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="6"
                                                            Padding="6,2"
                                                            CornerRadius="5"
                                                            Background="#D9FFFFFF">
                                                        <TextBlock Text="{Binding CodigoBarras}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                                    </Border>
                                                </Panel>
                                            </Border>

                                            <!-- Nombre y Categoría -->
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Nombre}"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{Binding Categoria.Nombre}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                            </StackPanel>

                                            <!-- Precio y Botón Rápido "+" para Agregar al Carrito -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PrecioVenta, StringFormat='Bs. {0:N2}'}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryAccentBrush}"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="1"
                                                        Width="34"
                                                        Height="34"
                                                        Padding="0"
                                                        CornerRadius="8"
                                                        ToolTip.Tip="Agregar al carrito"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:PosViewModel)DataContext).AgregarDesdeTarjetaCommand}"
                                                        CommandParameter="{Binding}">
                                                    <materialIcons:MaterialIcon Kind="Plus"
                                                                                Width="18"
                                                                                Height="18"
                                                                                Foreground="#FFFFFF" />
                                                </Button>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Estado vacío cuando ningún producto coincide con la búsqueda -->
                    <Border Classes="Card"
                            Padding="24,18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding CatalogoVacio}"
                            IsHitTestVisible="False">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="PackageVariantRemove"
                                                        Width="32"
                                                        Height="32"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        HorizontalAlignment="Center" />
                            <TextBlock Text="No hay productos disponibles para mostrar"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>

            </Grid>

            <!-- ===================================================== -->
            <!-- FILA INFERIOR (44%): CARRITO DE COMPRAS (DATAGRID)    -->
            <!-- ===================================================== -->
            <Border Grid.Row="2"
                    Classes="Card"
                    Padding="16,12"
                    ClipToBounds="True">

                <Grid RowDefinitions="Auto,10,*">

                    <!-- Encabezado del Carrito + Cargador de Proforma (PASO 27) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,8,Auto">
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CartOutline"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                        VerticalAlignment="Center" />
                            <TextBlock Classes="label"
                                       Text="CARRITO DE COMPRA ACTUAL"
                                       VerticalAlignment="Center" />
                            <Border Padding="8,2"
                                    CornerRadius="999"
                                    Background="{StaticResource AccentSubtleBgBrush}"
                                    BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding ResumenArticulos}"
                                           Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Contenedor Horizontal para Cargar Proforma (PASO 27) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <TextBox Text="{Binding NroProformaBusqueda}"
                                     PlaceholderText="Nro Proforma"
                                     Width="125"
                                     FontSize="12.5"
                                     Padding="8,5"
                                     IsEnabled="{Binding ControlesHabilitados}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding CargarProformaCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <Button Classes="ghost"
                                    Command="{Binding CargarProformaCommand}"
                                    IsEnabled="{Binding ControlesHabilitados}"
                                    Padding="10,5"
                                    ToolTip.Tip="Importar productos y cliente desde una Proforma">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <materialIcons:MaterialIcon Kind="FileDownloadOutline"
                                                                Width="15"
                                                                Height="15"
                                                                VerticalAlignment="Center" />
                                    <TextBlock Text="Cargar"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding $parent[Button].Foreground}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Classes="danger-ghost"
                                Content="Vaciar Carrito"
                                Command="{Binding VaciarCarritoCommand}"
                                IsVisible="{Binding TieneProductosEnCarrito}"
                                IsEnabled="{Binding ControlesHabilitados}"
                                Padding="12,5"
                                FontSize="12" />
                    </Grid>

                    <!-- DataGrid del Carrito -->
                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Carrito}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <!-- Producto + Badge de Promoción (PASO 29) -->
                                <DataGridTemplateColumn Header="PRODUCTO" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="entities:DetalleVenta">
                                            <StackPanel Margin="12,5" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding Producto.Nombre}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Padding="7,2"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left"
                                                        Background="#ECFDF5"
                                                        BorderBrush="#A7F3D0"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding TienePromocion}">
                                                    <TextBlock Text="{Binding BadgePromocionTexto}"
                                                               FontSize="10.5"
                                                               FontWeight="Bold"
                                                               Foreground="#059669" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Cantidad con controles +/- -->
                                <DataGridTemplateColumn Header="CANTIDAD" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="entities:DetalleVenta">
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="8"
                                                        Margin="6,4">
                                                <Button Classes="ghost"
                                                        Content="−"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:PosViewModel)DataContext).DisminuirCantidadCommand}"
                                                        CommandParameter="{Binding}" />

                                                <TextBlock Text="{Binding Cantidad}"
                                                           FontWeight="Bold"
                                                           MinWidth="26"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center" />

                                                <Button Classes="ghost"
                                                        Content="+"
                                                        Width="28"
                                                        Height="28"
                                                        Padding="0"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:PosViewModel)DataContext).IncrementarCantidadCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Precio Unitario -->
                                <DataGridTextColumn Header="P. UNITARIO"
                                                    Width="130"
                                                    Binding="{Binding PrecioUnitario, StringFormat='Bs {0:N2}'}"
                                                    x:DataType="entities:DetalleVenta" />

                                <!-- Subtotal -->
                                <DataGridTextColumn Header="SUBTOTAL"
                                                    Width="140"
                                                    Binding="{Binding Subtotal, StringFormat='Bs {0:N2}'}"
                                                    x:DataType="entities:DetalleVenta" />

                                <!-- Quitar ítem -->
                                <DataGridTemplateColumn Header="" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="entities:DetalleVenta">
                                            <Button Classes="danger-ghost"
                                                    Content="✕"
                                                    Width="28"
                                                    Height="26"
                                                    Padding="0"
                                                    FontSize="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:PosViewModel)DataContext).EliminarDelCarritoCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Estado vacío amigable sobre el DataGrid -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    IsVisible="{Binding CarritoVacio}"
                                    IsHitTestVisible="False">
                            <TextBlock Text="El carrito está vacío"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Haz clic en '+' sobre cualquier tarjeta o escanea un código de barras USB."
                                       FontSize="12.5"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Opacity="0.8"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- ========================================================= -->
        <!-- COLUMNA DERECHA (30%): PANEL DE COBRO                     -->
        <!-- ========================================================= -->
        <Border Grid.Column="2"
                Classes="Card"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Barra superior Verde Esmeralda -->
                <Border Grid.Row="0"
                        Height="4"
                        Background="{StaticResource PrimaryAccentBrush}" />

                <!-- Bloque de Total Gigante -->
                <Border Grid.Row="1"
                        Padding="22,18"
                        Background="{StaticResource PrimaryBackgroundBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Classes="label"
                                       Text="TOTAL A COBRAR" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ResumenArticulos}"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>

                        <TextBlock Text="{Binding TotalFormateado}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryAccentBrush}" />

                        <!-- Total ahorrado en promociones (PASO 29) -->
                        <Border Padding="8,3"
                                CornerRadius="6"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AccentSubtleBgBrush}"
                                BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding TieneDescuentoTotal}">
                            <TextBlock Text="{Binding TotalAhorradoTexto}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Cuerpo del Cobro -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" Margin="22,18">

                        <!-- Selector de Vendedor que cerró el trato (Sistema de Recompensas POS - PASO 14) -->
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="AccountTieOutline"
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Classes="label"
                                           Text="VENDEDOR ASIGNADO *"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ComboBox ItemsSource="{Binding VendedoresDisponibles}"
                                      SelectedItem="{Binding VendedorSeleccionado}"
                                      PlaceholderText="Seleccione quién concretó la venta..."
                                      IsEnabled="{Binding ControlesHabilitados}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Empleado">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding NombreCompleto}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="•"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding Puesto}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Selector de Método de Pago -->
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label"
                                       Text="MÉTODO DE PAGO" />
                            <Grid ColumnDefinitions="*,8,*,8,*">
                                <Button Grid.Column="0"
                                        Content="Efectivo"
                                        Command="{Binding SeleccionarEfectivoCommand}"
                                        Classes.ghost="{Binding NoEsPagoEfectivo}"
                                        IsEnabled="{Binding ControlesHabilitados}"
                                        Padding="8,9"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />

                                <Button Grid.Column="2"
                                        Content="QR"
                                        Command="{Binding SeleccionarQrCommand}"
                                        Classes.ghost="{Binding NoEsPagoQr}"
                                        IsEnabled="{Binding ControlesHabilitados}"
                                        Padding="8,9"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />

                                <Button Grid.Column="4"
                                        Content="Crédito"
                                        Command="{Binding SeleccionarCreditoCommand}"
                                        Classes.ghost="{Binding NoEsPagoCredito}"
                                        IsEnabled="{Binding ControlesHabilitados}"
                                        Padding="8,9"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- DATOS PARA EL RECIBO (VISIBLE PERMANENTEMENTE - PASO 23.3) -->
                        <Border Background="{StaticResource PrimaryBackgroundBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="label"
                                           Text="DATOS PARA EL RECIBO (Opcional)"
                                           Foreground="{StaticResource PrimaryAccentHoverBrush}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label"
                                               Text="CI / NIT" />
                                    <TextBox Text="{Binding NitFactura}"
                                             PlaceholderText="Ej. 5948210 o 0"
                                             IsEnabled="{Binding ControlesHabilitados}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter"
                                                        Command="{Binding BuscarOCrearClienteCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label"
                                               Text="NOMBRE / RAZÓN SOCIAL" />
                                    <TextBox Text="{Binding NombreFactura}"
                                             PlaceholderText="Ej. Juan Pérez o S/N"
                                             IsEnabled="{Binding ControlesHabilitados}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OPCIÓN 1: PAGO EN EFECTIVO -->
                        <StackPanel Spacing="16" IsVisible="{Binding EsPagoEfectivo}">
                            <!-- Monto Recibido -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Classes="label"
                                               Text="MONTO RECIBIDO (BS)"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="link"
                                            Content="Limpiar"
                                            Command="{Binding LimpiarMontoCommand}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            Padding="6,2" />
                                </Grid>

                                <TextBox x:Name="TxtMontoRecibido"
                                         Text="{Binding MontoRecibidoTexto}"
                                         PlaceholderText="0.00"
                                         FontSize="20"
                                         FontWeight="Bold"
                                         IsEnabled="{Binding ControlesHabilitados}" />
                            </StackPanel>

                            <!-- Botones Rápidos de Billetes -->
                            <StackPanel Spacing="8">
                                <TextBlock Classes="label"
                                           Text="BILLETES RÁPIDOS" />
                                <Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="*,8,*,8,*">
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Classes="quick-bill"
                                            Content="+10"
                                            Command="{Binding Sumar10Command}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Classes="quick-bill"
                                            Content="+20"
                                            Command="{Binding Sumar20Command}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="4"
                                            Classes="quick-bill"
                                            Content="+50"
                                            Command="{Binding Sumar50Command}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />

                                    <Button Grid.Row="2" Grid.Column="0"
                                            Classes="quick-bill"
                                            Content="+100"
                                            Command="{Binding Sumar100Command}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="2"
                                            Classes="quick-bill"
                                            Content="+200"
                                            Command="{Binding Sumar200Command}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="4"
                                            Classes="ghost"
                                            Content="Exacto"
                                            Command="{Binding MontoExactoCommand}"
                                            IsEnabled="{Binding ControlesHabilitados}"
                                            Padding="8,9"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <!-- Cambio Dado en Verde (#10B981) -->
                            <Border Padding="16,14"
                                    CornerRadius="10"
                                    Background="{StaticResource SuccessSubtleBgBrush}"
                                    BorderBrush="{StaticResource SuccessSubtleBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label"
                                               Text="CAMBIO A ENTREGAR"
                                               Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                                    <TextBlock Text="{Binding CambioFormateado}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- OPCIÓN 2: PAGO POR QR BANCARIO REAL (PASO 31) -->
                        <StackPanel Spacing="12"
                                    HorizontalAlignment="Stretch"
                                    IsVisible="{Binding EsPagoQr}">

                            <!-- Cuando existe QR configurado en BD -->
                            <Border Padding="16,14"
                                    CornerRadius="12"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource PrimaryAccentBrush}"
                                    BorderThickness="2"
                                    IsVisible="{Binding TieneQrBancario}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <TextBlock Text="ESCANEE EL QR PARA PAGAR"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                               HorizontalAlignment="Center" />

                                    <Image Source="{Binding QrPagoBitmap}"
                                           Width="230"
                                           Height="230"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center" />

                                    <Border Padding="12,6"
                                            CornerRadius="8"
                                            Background="{StaticResource AccentSubtleBgBrush}"
                                            BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                                            <TextBlock Text="MONTO EXACTO A COBRAR"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding TotalFormateado}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BancoQr}"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TitularQr}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Aviso claro si aún no se cargó ningún QR en Configuración -->
                            <Border Padding="16,14"
                                    CornerRadius="10"
                                    Background="#FEF3C7"
                                    BorderBrush="#FDE68A"
                                    BorderThickness="1.5"
                                    IsVisible="{Binding SinQrBancario}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="QrcodeRemove"
                                                                Width="28"
                                                                Height="28"
                                                                Foreground="#B45309"
                                                                HorizontalAlignment="Center" />
                                    <TextBlock Text="No hay un QR bancario configurado. Súbelo desde el módulo de Configuración."
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#B45309"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- OPCIÓN 3: PANEL DE CLIENTE PARA VENTA A CRÉDITO -->
                        <Border Background="{StaticResource PrimaryBackgroundBrush}"
                                BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                IsVisible="{Binding IsPagoCredito}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="label"
                                               Text="PANEL DE CLIENTE (CRÉDITO)"
                                               Foreground="{StaticResource PrimaryAccentHoverBrush}" />
                                    <TextBlock Classes="subtitle"
                                               FontSize="11"
                                               Text="Complete el celular y fecha límite, y confirme al cliente con su CI/NIT." />
                                </StackPanel>

                                <!-- TextBox para Celular/WhatsApp -->
                                <StackPanel Spacing="5">
                                    <TextBlock Classes="label"
                                               Text="CELULAR / WHATSAPP (CON CÓD. PAÍS)" />
                                    <TextBox Text="{Binding CelularClienteNuevo}"
                                             PlaceholderText="Ej. 59170012345"
                                             IsEnabled="{Binding ControlesHabilitados}" />
                                </StackPanel>

                                <!-- FECHA LÍMITE DE PAGO (PASO 18) -->
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="CalendarClock"
                                                                    Width="14"
                                                                    Height="14"
                                                                    Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                                    VerticalAlignment="Center" />
                                        <TextBlock Classes="label"
                                                   Text="FECHA LÍMITE DE PAGO"
                                                   Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource AccentSubtleBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="2">
                                        <CalendarDatePicker SelectedDate="{Binding FechaLimiteCredito, Mode=TwoWay}"
                                                            SelectedDateFormat="Custom"
                                                            CustomDateFormatString="dd/MM/yyyy"
                                                            PlaceholderText="Seleccionar fecha..."
                                                            Foreground="{StaticResource PrimaryTextBrush}"
                                                            IsEnabled="{Binding ControlesHabilitados}"
                                                            HorizontalAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="8,6" />
                                    </Border>
                                    <TextBlock Text="{Binding FechaLimiteCreditoTexto}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <!-- Botón "Confirmar Cliente" -->
                                <Button Content="Confirmar Cliente"
                                        Command="{Binding BuscarOCrearClienteCommand}"
                                        IsEnabled="{Binding ControlesHabilitados}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" />

                                <!-- Indicador visual en verde cuando el cliente ya está seleccionado -->
                                <Border Padding="12,10"
                                        CornerRadius="8"
                                        Background="{StaticResource SuccessSubtleBgBrush}"
                                        BorderBrush="{StaticResource SuccessSubtleBorderBrush}"
                                        BorderThickness="1"
                                        IsVisible="{Binding TieneClienteSeleccionado}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TextoClienteConfirmado}"
                                                   Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DetalleClienteConfirmado}"
                                                   Foreground="{StaticResource PrimaryAccentHoverBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Botones Principales: Completar Venta y Cerrar Caja (PASO 24) -->
                <Border Grid.Row="3"
                        Padding="22,14"
                        Background="{StaticResource PrimaryBackgroundBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Spacing="10">
                        <Button Content="{Binding TextoBotonCompletar}"
                                Command="{Binding CompletarVentaCommand}"
                                Height="52"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center" />

                        <Button Classes="ghost"
                                Command="{Binding CerrarCajaCommand}"
                                IsEnabled="{Binding ControlesHabilitados}"
                                Height="38"
                                Background="#FFFBEB"
                                BorderBrush="#FCD34D"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="LockOutline"
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="#B45309"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="Cerrar Caja (Arqueo del Día)"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#B45309"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
